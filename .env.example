# ── Required ─────────────────────────────────────────────────────────────────
# PostgreSQL. Locally: your own Postgres. On Netlify: provision Netlify DB
# (Neon) and NETLIFY_DATABASE_URL is injected automatically — DATABASE_URL
# then stays unset.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fullthrottle"

# Session signing for customer auth (Auth.js) and the admin JWT.
# Generate one: openssl rand -base64 32
AUTH_SECRET=""

# First OWNER admin — created by the seed when no admin exists yet.
# TOTP two-factor setup runs on the first sign-in at /admin.
ADMIN_EMAIL=""
ADMIN_INITIAL_PASSWORD=""

# ── Payments (checkout works end-to-end once these are set) ──────────────────
# STRIPE_SECRET_KEY=sk_live_…          # or sk_test_… while testing
# STRIPE_PUBLISHABLE_KEY=pk_live_…
# STRIPE_WEBHOOK_SECRET=whsec_…        # webhook endpoint: /api/webhooks/stripe
# PAYPAL_CLIENT_ID=
# PAYPAL_CLIENT_SECRET=
# PAYPAL_WEBHOOK_ID=                   # webhook endpoint: /api/webhooks/paypal
# PAYPAL_ENV=live                      # defaults to sandbox
# APPLE_PAY_DOMAIN_ASSOCIATION=        # file content from Stripe, served at /.well-known/…

# ── Social sign-in (buttons appear automatically when set) ───────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_CLIENT_ID=
# APPLE_CLIENT_SECRET=                 # the signed JWT client secret per Apple docs

# ── AI admin assistant (the Assistant tab in /admin) ─────────────────────────
# Easiest path: no env vars at all — the OWNER connects the key and picks the
# model in Admin → Integrations (stored encrypted in the database).
# These env values act as fallbacks; a key/model saved in the panel wins.
# OPENROUTER_API_KEY=sk-or-…          # openrouter.ai → Keys
# OPENROUTER_MODEL=anthropic/claude-opus-5  # any OpenRouter model slug

# ── Email (console fallback in dev when unset) ───────────────────────────────
# RESEND_API_KEY=
# EMAIL_FROM="Fullthrottle <orders@fullthrottle.com>"

# ── Optional ─────────────────────────────────────────────────────────────────
# AUTH_URL=https://fullthrottle.com    # absolute site URL for email links
# ADMIN_HOSTNAME=admin.fullthrottle.com # pins the admin realm to a subdomain
# ADMIN_SESSION_SECRET=                # separate admin JWT secret (falls back to AUTH_SECRET)
SUPPLIER_SYNC_ENABLED=false
